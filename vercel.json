{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "outputDirectory": "frontend",
  "rewrites": [
    { "source": "/play/:id", "destination": "/play.html?id=:id" },
    { "source": "/blog/:slug", "destination": "/api/blog-html?slug=:slug" },
    { "source": "/blog", "destination": "/blog.html" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/feed.xml", "destination": "/api/rss" }
  ],
  "crons": [
    { "path": "/api/blog-agent", "schedule": "0 9 * * *" }
  ],
  "functions": {
    "api/forge-game.ts": { "maxDuration": 60 },
    "api/blueprint.ts": { "maxDuration": 60 },
    "api/blog-agent.ts": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/((?!play/|play3d).*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/play/:id",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/play3d",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
