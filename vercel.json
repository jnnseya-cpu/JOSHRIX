{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "outputDirectory": "frontend",
  "rewrites": [
    {
      "source": "/play/:id",
      "destination": "/play.html?id=:id"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog-html?slug=:slug"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/feed.xml",
      "destination": "/api/rss"
    }
  ],
  "crons": [
    {
      "path": "/api/blog-agent",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/security-agent",
      "schedule": "0 7 * * *"
    }
  ],
  "functions": {
    "api/forge-game.ts": {
      "maxDuration": 300
    },
    "api/forge-enhance.ts": {
      "maxDuration": 300
    },
    "api/forge-selftest.ts": {
      "maxDuration": 300
    },
    "api/blueprint.ts": {
      "maxDuration": 120
    },
    "api/blog-agent.ts": {
      "maxDuration": 120
    },
    "api/security-agent.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/((?!play/|play3d).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "base-uri 'self'; object-src 'none'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/play/:id",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "base-uri 'self'; object-src 'none'; form-action 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/play3d",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ]
}
