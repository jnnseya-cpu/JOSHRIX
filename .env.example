# JOSHRIX Studio — environment variable names (values live in Secret Manager / local .env, NEVER in the repo)
# Copy to .env and fill in. Rotate any key that has ever been pasted into a chat, prompt, or document.

# AI providers (behind the AI Gateway)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=   # path to service-account JSON file, never the JSON inline

# Media generation (ultra-realism pipeline — see docs/REALISM-PIPELINE.md)
IMAGE_GEN_API_KEY=
MESHY_API_KEY=
TRIPO_API_KEY=
SKYBOX_API_KEY=
ELEVENLABS_API_KEY=
MUSIC_GEN_API_KEY=

# Payments
BITRIPAY_API_KEY=
BITRIPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# Financial ledger (Neon Postgres — money never lives solely in Firestore)
DATABASE_URL=

# Firebase / GCP
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=

# Comms
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Platform
JWT_SIGNING_KEY=
WEBHOOK_SIGNING_SECRET=

# Moderation (Build 3): human-review key for the admin queue
MODERATION_KEY=

# Content Agent autopilot: Vercel Cron auth (Vercel sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Communication engine: real email delivery — sandbox-logged until one rail is set.
# Rail 1 (preferred): your own domain mailbox via SMTP (e.g. Hostinger)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@joshrix.com
SMTP_PASS=
# Rail 2 (alternative): resend.com HTTP API
RESEND_API_KEY=
# Sender shown to recipients (defaults to SMTP_USER)
COMMS_FROM="JOSHRIX <no-reply@joshrix.com>"

# --- Human verification (account creation) -------------------------------
# Signing key for the proof-of-work challenge. UNSET = verification is OFF and
# signup falls back to rate limits alone, which is today's behaviour.
HUMAN_VERIFY_SECRET=
# Leading zero BITS required. 18 ≈ 0.3-1s in a browser. Raise under attack.
HUMAN_VERIFY_DIFFICULTY=18

# --- Traffic measurement --------------------------------------------------
# Salt for the daily-rotating, non-reversible visitor token. Falls back to
# MODERATION_KEY. No cookies are set and no IP is ever stored.
TRACK_SALT=
